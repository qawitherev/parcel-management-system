[
  {
    "name": "backend",
    "image": "${ecr_repository_url}:${github_sha}",
    "cpu": 0,
    "essential": true,
    "environment": [],
    "secrets": ${ssm_param_arns},
    "environmentFiles": [],
    "mountPoints": [],
    "portMappings": [
      {
        "appProtocol": "http",
        "containerPort": 5163,
        "hostPort": 5163,
        "name": "backend-port",
        "protocol": "tcp"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/parcel-management-system",
        "awslogs-create-group": "true",
        "awslogs-region": "ap-southeast-1",
        "awslogs-stream-prefix": "ecs"
      },
      "secretOptions": []
    },
    "systemControls": [],
    "ulimits": [],
    "volumesFrom": [],
    "healthCheck": {
      "command": [
        "CMD-SHELL",
        "curl -f http://localhost:5163/health || exit 1"
      ],
      "interval": 5,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 10
    }
  }
]
